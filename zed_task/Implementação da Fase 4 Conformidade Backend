class DashboardAnalyticsSelector:
    GOAL_EVENT_TYPES = [
        MatchEvent.EventType.GOAL,
        MatchEvent.EventType.OWN_GOAL,
        MatchEvent.EventType.PENALTY_SCORED,
    ]
