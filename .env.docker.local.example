# Local Docker only. Copy this file to .env.docker.local before starting.
# It is intentionally separate from the VPS profile (.env.production.local).
BACKEND_ENV_FILE=.env.docker.local
BACKEND_HTTP_PORT=8008

POSTGRES_DB=bolayetu
POSTGRES_USER=bolayetu_user
POSTGRES_PASSWORD=bolayetu_local_password

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=False

USE_CLOUDFLARE_R2=False
FRONTEND_URL=http://localhost:5173
POSTGRES_WAIT_MAX_ATTEMPTS=30
