# Copy to bybackend/.env.production.local for local production-like Docker
# testing or as the template for the VPS deployment file. Never commit the
# real file — it is covered by .gitignore.

# ── Django core ──────────────────────────────────────────────────────
POSTGRES_DB=bolayetu
POSTGRES_USER=bolayetu_user
POSTGRES_PASSWORD=replace-with-a-strong-password

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Replace with the real domain(s). Keep 127.0.0.1/localhost for local health checks.
DJANGO_ALLOWED_HOSTS=bolayetu.com,www.bolayetu.com,127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# ── CORS / CSRF ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.bolayetu.com,https://www.staging.bolayetu.com
CSRF_TRUSTED_ORIGINS=https://staging.bolayetu.com,https://www.staging.bolayetu.com

# ── JWT (rest_framework_simplejwt) ───────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7
# Leave unset to sign tokens with DJANGO_SECRET_KEY. Set a separate value to
# rotate JWT signing independently of the Django secret key.
JWT_SECRET_KEY=

# ── Security ──────────────────────────────────────────────────────────
# Keep True whenever the native Nginx terminates TLS in front of this app.
SECURE_SSL_REDIRECT=True

# ── Media storage — Cloudflare R2 (media_assets app) ─────────────────
# When False, files are stored on the local container filesystem — do not
# use False in production, uploads would not survive a redeploy.
USE_CLOUDFLARE_R2=True
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=bolayetu-storage
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_CDN_URL=https://cdn.bolayetu.com

# ── Redis / Celery ────────────────────────────────────────────────────
# REDIS_URL, CELERY_BROKER_URL and CELERY_RESULT_BACKEND are already set to
# the by-backend-redis container in docker-compose.prod.yml — override here
# only if using an external/managed Redis instead.
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# ── Email ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=Bolayetu <noreply@bolayetu.com>

# ── Frontend / Notifications ─────────────────────────────────────────
# Used to build links (e.g. password reset emails) — must be the public domain.
FRONTEND_URL=https://bolayetu.com
# Optional HTTP webhook for push notification delivery. Leave empty to disable.
NOTIFICATION_PUSH_ENDPOINT=

# ── Angola mobile-money gateways (reserved — not yet wired to code) ──
MCX_API_URL=MOCK
UNITEL_API_URL=MOCK

# ── Docker deployment ─────────────────────────────────────────────────
# Port bound on the VPS loopback interface; the native Nginx proxies here.
BACKEND_HTTP_PORT=8000
